OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=your_api_key_here
MODEL_NAME=qwen3.7-max-2026-05-17
MODEL_INPUT_COST_PER_1M_TOKENS=0
MODEL_OUTPUT_COST_PER_1M_TOKENS=0

# arxiv / openalex / multi_source / local_rag / mcp_catalog / zotero
RETRIEVAL_MODE=arxiv
COMPARISON_LOCAL_FALLBACK_ENABLED=true
# 深度研究自动下载可信开放 PDF，并只召回与问题相关的全文页块
FULLTEXT_RESEARCH_ENABLED=true
FULLTEXT_MAX_PAPERS=3
FULLTEXT_CHUNKS_PER_PAPER=3
FULLTEXT_MAX_PDF_MB=25
FULLTEXT_DOWNLOAD_TIMEOUT=45
FULLTEXT_CACHE_DIR=data/cache/online_papers
CLARIFICATION_SEMANTIC_WITH_LLM=true
CLARIFICATION_SEMANTIC_CONFIDENCE_THRESHOLD=0.8
LONG_TERM_MEMORY_ENABLED=true
LONG_TERM_MEMORY_DB_PATH=data/memory/long_term_research_memory.db
LONG_TERM_MEMORY_VALUE_THRESHOLD=0.75
LONG_TERM_MEMORY_TOP_K=3
LONG_TERM_MEMORY_SNAPSHOT_DAYS=30
LONG_TERM_MEMORY_CONTEXT_MAX_CHARS=3000
PRODUCT_DB_PATH=data/product/paper_agent_product.db
PERSONAL_LIBRARY_FILES_DIR=data/personal_libraries
PERSONAL_LIBRARY_MAX_PDF_MB=25
AUTH_TOKEN_TTL_HOURS=24
REPORT_OUTPUT_DIR=outputs/research_reports
PRODUCT_DB_PATH=data/product/paper_agent_product.db
PERSONAL_LIBRARY_FILES_DIR=data/personal_libraries
PERSONAL_LIBRARY_MAX_PDF_MB=25
AUTH_TOKEN_TTL_HOURS=24
CLARIFICATION_SEMANTIC_WITH_LLM=true
CLARIFICATION_SEMANTIC_CONFIDENCE_THRESHOLD=0.8
ANSWER_REFLECTION_ENABLED=true
LOCAL_RAG_MAX_RESULTS=5
ARXIV_MAX_RESULTS=5
MULTI_SOURCE_PROVIDERS=arxiv,openalex
MULTI_SOURCE_MAX_RESULTS=8
MULTI_SOURCE_RERANK_ENABLED=false
MULTI_SOURCE_METADATA_VERIFICATION_ENABLED=false
ARXIV_AUTHORITY_VERIFICATION_ENABLED=false
DOI_AUTHORITY_VERIFICATION_ENABLED=false
MULTI_SOURCE_PARALLEL_ENABLED=false
MULTI_SOURCE_MAX_WORKERS=2
MULTI_QUERY_PARALLEL_ENABLED=false
MULTI_QUERY_MAX_WORKERS=2
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_API_KEY=
OPENALEX_MAILTO=
OPENALEX_MAX_RESULTS=5
CROSSREF_BASE_URL=https://api.crossref.org
CROSSREF_MAILTO=
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_API_KEY=

# Zotero 只读 MCP：私有库需要 Library ID 和只读 API Key
ZOTERO_API_BASE_URL=https://api.zotero.org
ZOTERO_LIBRARY_TYPE=user
ZOTERO_LIBRARY_ID=
ZOTERO_API_KEY=
ZOTERO_MAX_RESULTS=5

# GitHub 只读 MCP（公开仓库可不填 Token；填写后可提高 API 限额并访问已授权私有仓库）
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_MAX_RESULTS=5
# 仅在用户明确写出 GitHub 时允许将检索词发送到 GitHub API
GITHUB_ENRICHMENT_ENABLED=false

# 指定 PDF 页面视觉分析（默认只做页面文本；开启后页面图像会发送给视觉模型）
PDF_MAX_SELECTED_PAGES=3
PDF_PAGE_IMAGE_CACHE_DIR=data/cache/pdf_pages
PDF_VISION_ENABLED=false
PDF_VISION_MODEL_NAME=qwen3.5-ocr

# Research Writer 输出预算，避免长篇生成超过上游连接持续时间
GENERATE_MAX_TOKENS=3200
GENERATE_THINKING_BUDGET=400

TOOL_TIMEOUT_SECONDS=45

EVALUATE_WITH_LLM=false

LLM_TIMEOUT=120
MAX_GENERATE_DOCS=3
DOC_CONTENT_LIMIT=1000

LOG_LEVEL=INFO
LOG_FILE=logs/paper_agent.log

REASON_WITH_LLM=true
REASON_CONFIDENCE_THRESHOLD=0.75
RESEARCH_ANALYSIS_WITH_LLM=true
RESEARCH_ANALYZER_PROMPT_VARIANT=zero_shot

CACHE_DIR=data/cache
MEMORY_DB_PATH=data/memory/paper_agent_memory.db
MEMORY_RECENT_MESSAGES=6
MEMORY_SUMMARY_MAX_CHARS=1200
MEMORY_CONTEXT_MAX_CHARS=2400
LLM_WIKI_DIR=data/wiki
LLM_WIKI_AUTO_PUBLISH_ENABLED=false
LLM_WIKI_ALLOWED_TASK_TYPES=summarize,compare,recommend,literature_review,paper_critique
LANGGRAPH_CHECKPOINT_ENABLED=true
LANGGRAPH_CHECKPOINT_DB_PATH=data/memory/langgraph_checkpoints.db

PDF_MAX_CHARS=12000
